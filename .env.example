# Perso Application Configuration Template
# DO NOT COMMIT SENSITIVE VALUES TO VERSION CONTROL

# Environment & Server
ENVIRONMENT=development
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info
DEMO_AUTH_ENABLED=false

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=perso
POSTGRES_PASSWORD=perso_secret_change_me
POSTGRES_DB=perso_db
POSTGRES_SSLMODE=disable

# MongoDB (Raw message store and conversation histories)
MONGODB_URI=mongodb://perso_user:perso_mongo_pass@mongodb:27017/perso_raw?authSource=admin
MONGODB_DATABASE=perso_raw

# Redis (Stream queue & pubsub)
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_STREAM_KEY=perso:telegram:messages
REDIS_CONSUMER_GROUP=perso:message_workers
REDIS_CONSUMER_NAME=worker-1

# Telegram MTProto Configuration
# Obtain API credentials from https://my.telegram.org
TELEGRAM_APP_ID=0
TELEGRAM_APP_HASH=
TELEGRAM_PHONE_NUMBER=
TELEGRAM_SESSION_DIR=/data/sessions
TELEGRAM_SESSION_STORAGE_KEY=perso-mtproto-session-encryption-key-32b!
# Set to true to run mock telegram collector for testing/demo without MTProto credentials
TELEGRAM_MOCK_MODE=false

# LLM / Gemini Configuration
# WARNING: By default, LLM processing of Telegram messages is DISABLED for privacy
# and Telegram Terms of Service compliance. Enable only after explicit legal/consent verification.
LLM_ENABLED=false
LLM_PROVIDER=gemini
# Optional server-side OpenAI-compatible provider; keep disabled until permitted.
LLM_BASE_URL=http://llm-mock:8091/v1
LLM_MODEL=perso-healthcare-mock
LLM_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LLM_TIMEOUT_SECONDS=15
LLM_MAX_RETRIES=3

# Processing & Worker
WORKER_CONCURRENCY=4
BATCH_SIZE=20
POLL_INTERVAL_MS=1000

# Conversation Management
CONVERSATION_MAX_QUESTIONS=7
CONVERSATION_COOLDOWN_HOURS=24
CONVERSATION_AUTO_APPROVE=false

# Single operator/workspace identity. Use random values of at least 32 characters.
API_TOKEN=
OPERATOR_USER_ID=11111111-1111-1111-1111-111111111111
TELEGRAM_GATEWAY_URL=http://telegram-gateway:8090
TELEGRAM_GATEWAY_ADDR=0.0.0.0:8090
TELEGRAM_GATEWAY_TOKEN=
TELEGRAM_BACKFILL_LIMIT=100
OUTREACH_ENABLED=false
# 0 keeps data indefinitely; a positive value explicitly opts into deletion.
RETENTION_DAYS=0
# Optional typed intake fields; default catalog is electronics. Dates use Gregorian YYYY-MM-DD.
CONVERSATION_FIELDS=price,condition,branded,manufacturer,warranty_until,seller_city,seller_tehran_area

# Step 2: explicit first-install bootstrap; existing accounts are never overwritten.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
# true in production behind HTTPS, false only for development HTTP.
AUTH_COOKIE_SECURE=false
