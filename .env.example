# Perso Application Configuration Template
# DO NOT COMMIT SENSITIVE VALUES TO VERSION CONTROL

# Environment & Server
ENVIRONMENT=development
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=perso
POSTGRES_PASSWORD=perso_secret_change_me
POSTGRES_DB=perso_db
POSTGRES_SSLMODE=disable

# MongoDB (Raw message store and conversation histories)
MONGODB_URI=mongodb://perso_user:perso_mongo_pass@mongodb:27017/perso_raw?authSource=admin
MONGODB_DATABASE=perso_raw

# Redis (Stream queue & pubsub)
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_STREAM_KEY=perso:telegram:messages
REDIS_CONSUMER_GROUP=perso:message_workers
REDIS_CONSUMER_NAME=worker-1

# Telegram MTProto Configuration
# Obtain API credentials from https://my.telegram.org
TELEGRAM_APP_ID=0
TELEGRAM_APP_HASH=
TELEGRAM_PHONE_NUMBER=
TELEGRAM_SESSION_DIR=/data/sessions
TELEGRAM_SESSION_STORAGE_KEY=perso-mtproto-session-encryption-key-32b!
# Set to true to run mock telegram collector for testing/demo without MTProto credentials
TELEGRAM_MOCK_MODE=false

# LLM / Gemini Configuration
# WARNING: By default, LLM processing of Telegram messages is DISABLED for privacy
# and Telegram Terms of Service compliance. Enable only after explicit legal/consent verification.
LLM_ENABLED=false
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LLM_TIMEOUT_SECONDS=15
LLM_MAX_RETRIES=3

# Processing & Worker
WORKER_CONCURRENCY=4
BATCH_SIZE=20
POLL_INTERVAL_MS=1000

# Conversation Management
CONVERSATION_MAX_QUESTIONS=3
CONVERSATION_COOLDOWN_HOURS=24
CONVERSATION_AUTO_APPROVE=false
